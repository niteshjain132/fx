<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootStack" styleClass="app-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.projecthub.ui.main.MainViewController">

    <BorderPane>
        <!-- Left Sidebar (Dark Slate #1E222A) -->
        <left>
            <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="240" minWidth="220" maxWidth="260">
                <padding>
                    <Insets top="24" right="16" bottom="16" left="16"/>
                </padding>

                <!-- Logo / Brand -->
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="brand-row">
                    <FontIcon fx:id="brandIcon" iconSize="28" styleClass="brand-icon"/>
                    <Label fx:id="brandTitle" text="ProjectHub" styleClass="brand-title"/>
                </HBox>

                <Separator styleClass="sidebar-separator">
                    <VBox.margin>
                        <Insets top="20" bottom="16"/>
                    </VBox.margin>
                </Separator>

                <!-- Navigation -->
                <VBox spacing="6" styleClass="nav-menu" VBox.vgrow="ALWAYS">
                    <Button fx:id="navDashboard" text="Dashboard" styleClass="nav-button, nav-active" maxWidth="Infinity"
                            alignment="CENTER_LEFT"/>
                    <Button fx:id="navProjects" text="Active Projects" styleClass="nav-button" maxWidth="Infinity"
                            alignment="CENTER_LEFT"/>
                    <Button fx:id="navTasks" text="Task Board" styleClass="nav-button" maxWidth="Infinity"
                            alignment="CENTER_LEFT"/>
                    <Button fx:id="navReleases" text="Releases" styleClass="nav-button" maxWidth="Infinity"
                            alignment="CENTER_LEFT"/>
                    <Button fx:id="navAnalytics" text="Team Analytics" styleClass="nav-button" maxWidth="Infinity"
                            alignment="CENTER_LEFT"/>
                </VBox>

                <!-- System Status -->
                <VBox spacing="6" styleClass="status-card">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <Label text="System Status" styleClass="status-card-title"/>
                    <Label fx:id="springStatusLabel" text="Spring Engine: OK" styleClass="status-card-value"/>
                </VBox>

                <!-- Settings footer -->
                <Button fx:id="settingsButton" text="Settings" styleClass="settings-button" maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <FontIcon fx:id="settingsIcon" iconSize="16"/>
                    </graphic>
                    <VBox.margin>
                        <Insets top="12"/>
                    </VBox.margin>
                </Button>
            </VBox>
        </left>

        <!-- Main content host -->
        <center>
            <StackPane fx:id="contentHost" styleClass="content-host">
                <VBox fx:id="dashboardView" styleClass="dashboard-view" spacing="20">
                    <padding>
                        <Insets top="28" right="28" bottom="28" left="28"/>
                    </padding>

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="headerTitle" text="Dashboard Overview" styleClass="page-title"/>
                            <Label fx:id="headerSubtitle"
                                   text="Personalized dashboard for engineering projects"
                                   styleClass="page-subtitle"/>
                        </VBox>
                        <ComboBox fx:id="workspaceSelector" promptText="Workspace" styleClass="workspace-selector"
                                  prefWidth="180"/>
                    </HBox>

                    <!-- Metric Cards Row -->
                    <GridPane hgap="16" vgap="16" styleClass="metrics-row">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        </columnConstraints>

                        <VBox styleClass="metric-card" spacing="8" GridPane.columnIndex="0">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <Label text="Active Projects" styleClass="metric-label"/>
                            <Label fx:id="metricProjectsValue" text="12" styleClass="metric-value"/>
                            <Label fx:id="metricProjectsTrend" text="+38%" styleClass="metric-badge, badge-success"/>
                        </VBox>

                        <VBox styleClass="metric-card" spacing="8" GridPane.columnIndex="1">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <Label text="Open Sprint Tasks" styleClass="metric-label"/>
                            <Label fx:id="metricTasksValue" text="45" styleClass="metric-value"/>
                            <Label fx:id="metricTasksBadge" text="12 high priority"
                                   styleClass="metric-badge, badge-warning"/>
                        </VBox>

                        <VBox styleClass="metric-card" spacing="8" GridPane.columnIndex="2">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <Label text="Releases This Week" styleClass="metric-label"/>
                            <Label fx:id="metricReleasesValue" text="3" styleClass="metric-value"/>
                            <Label text="▁▂▃▅▄▆█" styleClass="metric-sparkline"/>
                        </VBox>

                        <VBox styleClass="metric-card" spacing="8" GridPane.columnIndex="3">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <Label text="Velocity" styleClass="metric-label"/>
                            <Label fx:id="metricVelocityValue" text="41 pts/week" styleClass="metric-value"/>
                            <Label text="pts/week" styleClass="metric-hint"/>
                        </VBox>
                    </GridPane>

                    <!-- Two-column content -->
                    <HBox spacing="20" VBox.vgrow="ALWAYS">
                        <!-- Left: Active Projects -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="projects-column">
                            <Label text="Active Projects Progress" styleClass="section-title"/>
                            <ScrollPane fitToWidth="true" styleClass="projects-scroll" VBox.vgrow="ALWAYS">
                                <VBox fx:id="projectListContainer" spacing="0" styleClass="project-list"/>
                            </ScrollPane>
                        </VBox>

                        <!-- Right: Sidebar widgets -->
                        <VBox spacing="16" prefWidth="300" minWidth="280" maxWidth="340" styleClass="widgets-column">
                            <VBox spacing="12" styleClass="widget-card" VBox.vgrow="NEVER">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                <Label text="Upcoming Milestones" styleClass="widget-title"/>
                                <VBox fx:id="milestonesContainer" spacing="10"/>
                            </VBox>

                            <VBox spacing="12" styleClass="widget-card" VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                <Label text="Team Activity Feed" styleClass="widget-title"/>
                                <ScrollPane fitToWidth="true" styleClass="activity-scroll" VBox.vgrow="ALWAYS">
                                    <VBox fx:id="activityContainer" spacing="12"/>
                                </ScrollPane>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
