<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="cardRoot" styleClass="project-card" spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projecthub.ui.card.ProjectCardController">
    <padding>
        <Insets top="16" right="18" bottom="16" left="18"/>
    </padding>

    <!-- Project name + progress -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label fx:id="projectNameLabel" text="Project Name" styleClass="project-card-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="progressBar" progress="0.5" prefWidth="220" maxWidth="Infinity"
                             HBox.hgrow="ALWAYS" styleClass="project-progress"/>
                <Label fx:id="progressLabel" text="0%" styleClass="project-progress-label" minWidth="40"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Tech stack pills -->
    <FlowPane fx:id="techStackPane" hgap="8" vgap="8" styleClass="tech-stack"/>

    <!-- Branch selector + Open -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <ComboBox fx:id="branchComboBox" promptText="Select branch" prefWidth="240" maxWidth="Infinity"
                  HBox.hgrow="ALWAYS" styleClass="branch-combo"/>
        <Region minWidth="8"/>
        <Button fx:id="openButton" text="Open" styleClass="open-button" minWidth="100">
            <graphic>
                <FontIcon fx:id="openIcon" iconSize="14"/>
            </graphic>
        </Button>
    </HBox>
</VBox>
